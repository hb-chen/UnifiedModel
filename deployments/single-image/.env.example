# Image identity. Used by build.sh, run.sh, and docker compose.
UMODEL_IMAGE=umodel:local

# Runtime container settings. Used by run.sh, health.sh, and docker compose.
UMODEL_HOST_DATA=.run/umodel-ladybug/data
UMODEL_WEB_PORT=5173
UMODEL_API_PORT=8080
UMODEL_MCP_PORT=8090

# Build settings for the Ladybug native runtime and target platform. Used only by build.sh.
LADYBUG_VERSION=0.13.1
LADYBUG_OS=linux
LADYBUG_ARCH=x86_64
DOCKER_PLATFORM=linux/amd64
LADYBUG_DOWNLOAD_URL=

# Build base images. Used only by build.sh.
NODE_IMAGE=node:22-bookworm-slim
GOLANG_IMAGE=golang:1.25-trixie
NGINX_IMAGE=nginx:1.29-trixie
